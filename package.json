{
    "name": "doublets-game",
    "version": "1.0.0",
    "description": "An NYT Games-style web app for playing the word game Doublets",
    "homepage": "https://github.com/sam-jordan/doublets-game#readme",
    "bugs": {
        "url": "https://github.com/sam-jordan/doublets-game/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sam-jordan/doublets-game.git"
    },
    "license": "ISC",
    "author": "sam-jordan",
    "type": "module",
    "scripts": {
        "build": "tsc -b && vite build",
        "deploy": "npm run build && cdk deploy",
        "dev": "vite",
        "generate-puzzles": "npm run build && node dist/scripts/generate-puzzles.js",
        "generate-words": "npm run build && node dist/scripts/convert-words-to-json.js",
        "lint": "prettier --check . && xo",
        "lint:fix": "prettier --write . && xo --fix",
        "prepare": "husky",
        "preview": "vite preview",
        "solve-puzzle": "npm run build && node dist/scripts/solve-puzzle.js",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "aws-cdk-lib": "^2.263.0",
        "clsx": "^2.1.1",
        "luxon": "^3.7.2",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwindcss": "^4.3.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.4",
        "@types/eslint-plugin-jsx-a11y": "^6.10.1",
        "@types/luxon": "^3.7.3",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^5.1.1",
        "@vitest/coverage-v8": "^4.1.10",
        "aws-cdk": "^2.1135.0",
        "eslint-config-xo-react": "^0.31.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "sort-package-json": "^4.0.0",
        "typescript": "~5.9.3",
        "vite": "^7.3.1",
        "vitest": "^4.1.10",
        "xo": "^4.0.0"
    }
}
