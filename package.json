{
    "name": "doublets-game",
    "version": "1.0.0",
    "description": "An NYT Games-style web app for playing the word game Doublets",
    "homepage": "https://github.com/sam-jordan/doublets-game#readme",
    "bugs": {
        "url": "https://github.com/sam-jordan/doublets-game/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sam-jordan/doublets-game.git"
    },
    "license": "ISC",
    "author": "sam-jordan",
    "type": "module",
    "scripts": {
        "build": "tsc -b && vite build",
        "deploy": "cdk deploy --require-approval never",
        "dev": "vite",
        "dev:cache": "vite --mode cache",
        "generate-puzzles": "npm run build && node dist/scripts/generate-puzzles.js",
        "generate-words": "npm run build && node dist/scripts/convert-words-to-json.js",
        "lint": "prettier --check . && xo",
        "lint:fix": "prettier --write . && xo --fix",
        "prepare": "husky",
        "preview": "vite preview",
        "solve-puzzle": "npm run build && node dist/scripts/solve-puzzle.js",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@aws-lambda-powertools/parser": "^2.35.0",
        "@aws-sdk/client-dynamodb": "^3.1121.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "^5.102.8",
        "aws-amplify": "^6.20.0",
        "aws-cdk-lib": "^2.267.0",
        "clsx": "^2.1.1",
        "luxon": "^3.7.2",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.18.3",
        "tailwindcss": "^4.3.3",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@aws-sdk/lib-dynamodb": "^3.1121.0",
        "@eslint/compat": "^2.1.0",
        "@inquirer/prompts": "^8.7.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.6",
        "@types/aws-lambda": "^8.10.162",
        "@types/eslint-plugin-jsx-a11y": "^6.10.1",
        "@types/luxon": "^3.7.5",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/coverage-v8": "^4.1.11",
        "aws-cdk": "^2.1139.0",
        "esbuild": "^0.28.2",
        "eslint-config-xo-react": "^0.31.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.4.1",
        "prettier": "^3.9.6",
        "sort-package-json": "^4.0.0",
        "typescript": "~5.9.3",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "xo": "^4.0.0"
    }
}
