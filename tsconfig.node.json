{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "target": "ESNext",
        "lib": ["ESNext"],
        "module": "ESNext",
        "types": ["node"],
        "skipLibCheck": true,
        "rootDir": "scripts",
        "outDir": "dist",
        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true
    },
    "include": ["scripts"]
}
